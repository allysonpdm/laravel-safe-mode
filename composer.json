{
    "name": "allyson/laravel-safe-mode",
    "description": "Protege ambientes Laravel contra comandos Artisan destrutivos em produção, com auditoria completa.",
    "type": "library",
    "keywords": [
        "laravel",
        "safe-mode",
        "artisan",
        "protection",
        "audit",
        "production"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Allyson",
            "email": "allyson@example.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/http": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Allyson\\SafeMode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Allyson\\SafeMode\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Allyson\\SafeMode\\SafeModeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
